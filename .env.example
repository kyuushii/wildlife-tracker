# ========================================================
# WildSeason: Private Wildlife & Nature Tracker Environment Variables
# ========================================================

# [REQUIRED FOR PRIVATE ACCESS]
# Set the master password required to log in and unlock your deployment.
# Add this under "Environment Variables" in your Vercel Project Settings!
SITE_PASSWORD=choose_your_secure_password_here

# [OPTIONAL]
# Random secret string used for session token HMAC hashing.
AUTH_SECRET=wildlife-photographer-salt-2025

# [OPTIONAL] Supabase Cloud Backup (if using cross-device cloud sync)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
